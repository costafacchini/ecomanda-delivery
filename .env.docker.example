# MongoDB credentials
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=changeme
MONGO_DB=ecomanda-delivery

# Mongo container init (must match credentials above)
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_INITDB_DATABASE=ecomanda-delivery

# Mongo Express UI
ME_CONFIG_MONGODB_ADMINUSERNAME=root
ME_CONFIG_MONGODB_ADMINPASSWORD=changeme
ME_CONFIG_BASICAUTH_USERNAME=root
ME_CONFIG_BASICAUTH_PASSWORD=changeme
ME_CONFIG_MONGODB_URL=mongodb://root:changeme@mongo:27017/ecomanda-delivery?authSource=admin

# App database connection
MONGODB_URI=mongodb://root:changeme@mongo:27017/ecomanda-delivery?authSource=admin
